		"@tailwindcss/typography": "^0.5.19",
		"autoprefixer": "^10.5.0",
		"codemirror": "^6.0.2",
		"drizzle-orm": "^0.44.7",
		"file-type": "21.3.4",
		"next": "15.5.24",
		"next-auth": "5.0.0-beta.32",
		"postcss": "^8.5.15",
		"react": "^19.2.6",
		"react-dom": "^19.2.6",
		"react-markdown": "^10.1.0",
		"rehype-sanitize": "^6.0.0",
		"remark-breaks": "^4.0.0",
		"remark-gfm": "^4.0.1",
		"remark-parse": "^11.0.0",
		"unified": "^11.0.5",
		"zod": "^4.4.3"
	},
	"devDependencies": {
		"@eslint/eslintrc": "^3.3.5",
		"@tailwindcss/postcss": "^4.3.0",
		"@types/node": "^20.19.41",
		"@types/react": "^19.2.15",
		"@types/react-dom": "^19.2.3",
		"drizzle-kit": "^0.31.10",
		"eslint": "^9.39.4",
		"eslint-config-next": "15.5.24",
		"tailwindcss": "^4.3.0",
		"typescript": "^5",
		"vitest": "3.2.7",
		"wrangler": "^4.86.0"
	},
	"allowScripts": {
		"esbuild@0.18.20": true,
		"esbuild@0.25.4": true,
