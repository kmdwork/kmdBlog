{
	"name": "web",
	"version": "0.1.0",
	"private": true,
	"scripts": {
		"dev": "next dev",
		"build": "next build",
		"start": "next start",
		"lint": "next lint",
		"deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy --config wrangler.dev.jsonc",
		"preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
		"cf-typegen": "wrangler types --env-interface CloudflareEnv ./cloudflare-env.d.ts",
		"deploy:dev": "opennextjs-cloudflare build && wrangler deploy --config wrangler.dev.jsonc",
		"deploy:stg": "opennextjs-cloudflare build && wrangler deploy --config wrangler.stg.jsonc",
		"deploy:prod": "opennextjs-cloudflare build && wrangler deploy --config wrangler.prod.jsonc",
		"local:dev": "opennextjs-cloudflare build && wrangler dev --local --config wrangler.dev.jsonc"
	},
	"dependencies": {
		"@opennextjs/cloudflare": "^1.19.11",
		"@tailwindcss/typography": "^0.5.19",
		"autoprefixer": "^10.5.0",
		"drizzle-orm": "^0.44.7",
		"next": "^15.5.18",
		"next-auth": "^5.0.0-beta.31",
		"postcss": "^8.5.15",
		"react": "^19.2.6",
		"react-dom": "^19.2.6",
		"react-markdown": "^10.1.0",
		"rehype-sanitize": "^6.0.0",
		"remark-gfm": "^4.0.1",
		"zod": "^4.4.3"
	},
	"devDependencies": {
		"@eslint/eslintrc": "^3.3.5",
		"@tailwindcss/postcss": "^4.3.0",
		"@types/node": "^20.19.41",
		"@types/react": "^19.2.15",
		"@types/react-dom": "^19.2.3",
		"drizzle-kit": "^0.31.10",
		"eslint": "^9.39.4",
		"eslint-config-next": "15.4.6",
		"tailwindcss": "^4.3.0",
		"typescript": "^5",
		"wrangler": "^4.86.0"
	}
}
