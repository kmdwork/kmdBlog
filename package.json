{
	"name": "web",
	"version": "0.1.0",
	"private": true,
	"scripts": {
		"dev": "next dev",
		"build": "next build",
		"start": "next start",
		"lint": "next lint",
		"deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy --config wrangler.dev.jsonc",
		"preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
		"cf-typegen": "wrangler types --env-interface CloudflareEnv ./cloudflare-env.d.ts",
		"deploy:dev": "opennextjs-cloudflare build && wrangler deploy --config wrangler.dev.jsonc",
		"deploy:stg": "opennextjs-cloudflare build && wrangler deploy --config wrangler.stg.jsonc",
		"deploy:prod": "opennextjs-cloudflare build && wrangler deploy --config wrangler.prod.jsonc",
		"local:dev": "opennextjs-cloudflare build && wrangler dev --local --config wrangler.dev.jsonc"
	},
	"dependencies": {
		"@opennextjs/cloudflare": "^1.14.0",
		"@tailwindcss/typography": "^0.5.19",
		"autoprefixer": "^10.4.21",
		"drizzle-orm": "^0.44.6",
		"next": "^15.4.8",
		"next-auth": "^5.0.0-beta.29",
		"postcss": "^8.5.6",
		"react": "^19.1.2",
		"react-dom": "^19.1.2",
		"react-markdown": "^10.1.0",
		"rehype-sanitize": "^6.0.0",
		"remark-gfm": "^4.0.1",
		"zod": "^4.1.12"
	},
	"devDependencies": {
		"@eslint/eslintrc": "^3",
		"@tailwindcss/postcss": "^4",
		"@types/node": "^20.19.22",
		"@types/react": "^19",
		"@types/react-dom": "^19",
		"drizzle-kit": "^0.31.5",
		"eslint": "^9",
		"eslint-config-next": "15.4.6",
		"tailwindcss": "^4.1.16",
		"typescript": "^5",
		"wrangler": "^4.43.0"
	}
}
